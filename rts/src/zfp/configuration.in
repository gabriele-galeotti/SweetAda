
#
# Basic units.
#

LIBGNAT_SRCS_COMMON += ../common/a-charac.ads
LIBGNAT_SRCS_COMMON += ../common/a-chlat1.ads
LIBGNAT_SRCS_COMMON += ../common/a-unccon.ads
LIBGNAT_SRCS_COMMON += ../common/a-uncdea.ads
LIBGNAT_SRCS_COMMON += ../common/ada.ads
LIBGNAT_SRCS_COMMON += ../common/i-cexten.ads
LIBGNAT_SRCS_COMMON += ../common/interfac.ads
LIBGNAT_SRCS_COMMON += ../common/s-atacco.ads ../common/s-atacco.adb
LIBGNAT_SRCS_COMMON += ../common/s-maccod.ads
LIBGNAT_SRCS_COMMON += ../common/s-stoele.ads ../common/s-stoele.adb
LIBGNAT_SRCS_COMMON += ../common/s-unstyp.ads

LIBGNAT_SRCS_COMMON += i-c.ads
LIBGNAT_SRCS_COMMON += s-parame.ads

#
# system.ads default values.
#
export RESTRICTIONS_NO_EXCEPTION_PROPAGATION     := pragma Restrictions (No_Exception_Propagation);
export RESTRICTIONS_NO_EXCEPTION_REGISTRATION    := pragma Restrictions (No_Exception_Registration);
export RESTRICTIONS_NO_IMPLICIT_DYNAMIC_CODE     := pragma Restrictions (No_Implicit_Dynamic_Code);
export RESTRICTIONS_NO_IMPLICIT_HEAP_ALLOCATIONS := pragma Restrictions (No_Implicit_Heap_Allocations);
export COMMAND_LINE_ARGS         := False
export CONFIGURABLE_RUN_TIME     := True
export SUPPRESS_STANDARD_LIBRARY := True
export USE_ADA_MAIN_PROGRAM_NAME := False

